    ]
  },

  "formatStability": {
    "@id": "ssim.ch7.format_stability",
    "name": "SSIM Chapter 7 Format Stability",
    "description": "The SSIM Chapter 7 record format has been remarkably stable since the March 2011 edition. The core architecture — 200-byte fixed-width records, 1000-byte blocks, 5 record types (RT1-RT5), ASCII/EBCDIC encoding — has not changed across subsequent SSIM editions (25th through 31st). Updates between editions are limited to: (1) new code values within existing DEIs in Chapter 2 (aircraft types, service codes, traffic restrictions), (2) clarifications and editorial corrections to field-level guidance, (3) updated cross-references to WASG and other IATA standards. No new record types, no changes to field positions or lengths, no new encoding support (UTF-8/XML/JSON alternatives remain under discussion but not adopted). NDC, ONE Order, and AIDM operate at different layers and do not modify SSIM filing formats."
  },

  "references": [
    "IATA SSIM, March 2011 — Chapter 7 (Record Formats)",
    "IATA SSIM, Subsequent editions (25th-31st) — Chapter 2 DEI updates, Chapter 5 code table updates",
    "IATA SSIM, March 2011 — Chapter 5 (Code Tables)",
    "IATA Worldwide Airport Slot Guidelines (WASG) — Season boundary definitions (updated 2013, 2017, 2020, 2022)",
    "IATA Resolution 762 — Schedule information exchange (codeshare transparency updates)",
    "W3C JSON-LD 1.1 Specification (https://www.w3.org/TR/json-ld11/)",
    "W3C RDF 1.1 Specification (https://www.w3.org/TR/rdf11-concepts/)",
    "IATA Official Website (https://www.iata.org/)"
  ],

  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-04-14",
      "changes": [
        "Added newer DEIs to RT4 segment spec: DEI 010 (Aircraft Type), DEI 109 (Meal Service), DEI 111 (Operational Suffix), DEI 503 (Traffic Restriction), DEI 504 (Codeshare), DEI 505 (Electronic Ticketing)",
        "Updated RT3 aircraft_type field with post-2011 IATA aircraft codes (737 MAX family, A350-1000, A321neo/XLR, A220, 787-10, 777X)",
        "Clarified RT3 secure_flight_indicator with expanded applicability guidance (overflights, codeshare obligations, non-US APIS programs)",
        "Expanded RT3 traffic_restriction_code with EU261/EC261 regulatory codes and detailed restriction code table",
        "Clarified RT2 time_mode DST transition handling with detailed schedule-splitting guidance",
        "Updated RT2 season field with WASG reference and COVID-era filing practice notes",
        "Added formatStability section documenting Chapter 7 structural stability across editions",
        "Added deiVersioning section to shared vocabulary documenting DEI update history",
        "Updated references to include WASG, Resolution 762, and subsequent SSIM editions"
      ]
    },
    {
      "version": "1.0.0",
      "date": "2025-11-24",
      "changes": [
        "Initial unified SSIM specification",
        "Standardized @type to RecordSpecification across all records",
        "Converted field positions from 1-based to 0-based indexing",
        "Extracted shared vocabulary and semantic rules",
        "Added file-level extensions (file_summary, integrity_report, parsing_metadata)",
        "Added implementation guidance and parser architecture recommendations",
        "Unified encoding, status legend, and conventions across all records"
      ]
    }
  ]
