  "usageExamples": [
    {
      "@type": "UsageExample",
      "language": "elixir",
      "title": "Parse Carrier Record",
      "code": "# Parse a 200-byte SSIM Carrier record\nraw_record = \"2UXX  0008    07DEC2103MAR2203DEC21...\"\n\ncase AFSpecs.SSIM.CarrierRecord.parse(raw_record) do\n  {:ok, carrier} ->\n    IO.puts \"Airline: #{carrier.airline_designator}\"\n    IO.puts \"Time Mode: #{carrier.time_mode}\"\n    IO.puts \"Valid: #{carrier.period_of_validity_from} to #{carrier.period_of_validity_to}\"\n    IO.puts \"Status: #{carrier.schedule_status}\"\n    \n    # Check if schedule is active\n    if carrier.schedule_status == \"P\" do\n      IO.puts \"Schedule is PUBLISHED - process flight legs\"\n      process_flight_legs(carrier)\n    else\n      IO.puts \"Schedule is CANCELLED - remove existing flights\"\n      remove_flights(carrier.airline_designator)\n    end\n    \n  {:error, error} ->\n    IO.puts \"Parse failed: #{error.message}\"\nend"
    },
    {
      "@type": "UsageExample",
      "language": "elixir",
      "title": "Extract Carrier Schedule Periods",
      "code": "# Extract all carrier schedule periods from SSIM file\ndefmodule CarrierExtractor do\n  def extract_carriers(file_path) do\n    file_path\n    |> File.stream!([], 200)\n    |> Stream.filter(fn record -> String.at(record, 0) == \"2\" end)  # RT2 only\n    |> Stream.map(&AFSpecs.SSIM.CarrierRecord.parse/1)\n    |> Stream.filter(&match?({:ok, _}, &1))\n    |> Stream.map(fn {:ok, carrier} -> carrier end)\n    |> Enum.map(fn carrier ->\n      %{\n        airline: String.trim(carrier.airline_designator),\n        time_mode: carrier.time_mode,\n        valid_from: carrier.period_of_validity_from,\n        valid_to: carrier.period_of_validity_to,\n        status: carrier.schedule_status,\n        season: String.trim(carrier.season)\n      }\n    end)\n  end\nend\n\n# Usage\ncarriers = CarrierExtractor.extract_carriers(\"schedule.ssim\")\nIO.inspect(carriers)"
    },
    {
      "@type": "UsageExample",
      "language": "elixir",
      "title": "Process Multi-Carrier Schedule",
      "code": "# Process SSIM file with multiple carriers\ndefmodule SSIMProcessor do\n  def process_file(file_path) do\n    records = File.stream!(file_path, [], 200)\n    \n    # Group records by carrier\n    process_records(records, nil, [])\n  end\n  \n  defp process_records(records, current_carrier, current_flights) do\n    Enum.reduce(records, {nil, []}, fn record, {carrier, flights} ->\n      case String.at(record, 0) do\n        \"2\" ->  # New carrier (RT2)\n          # Save previous carrier's flights\n          if carrier, do: save_carrier_schedule(carrier, flights)\n          \n          # Parse new carrier\n          {:ok, new_carrier} = AFSpecs.SSIM.CarrierRecord.parse(record)\n          {new_carrier, []}\n        \n        \"3\" ->  # Flight leg (RT3)\n          {:ok, flight} = AFSpecs.SSIM.FlightLegRecord.parse(record)\n          {carrier, [flight | flights]}\n        \n        _ ->\n          {carrier, flights}\n      end\n    end)\n  end\n  \n  defp save_carrier_schedule(carrier, flights) do\n    IO.puts \"Saving #{length(flights)} flights for #{carrier.airline_designator}\"\n    # Save to database, apply time_mode, check schedule_status, etc.\n  end\nend"
    }
  ],
