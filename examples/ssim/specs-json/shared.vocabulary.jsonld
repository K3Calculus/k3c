{
  "@context": {
    "@vocab": "https://activeflights.com/specs/v1/ssim#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "iata": "https://www.iata.org/",
    "ssim": "https://activeflights.com/specs/v1/ssim#",
    "field": "https://activeflights.com/specs/v1/field#"
  },
  "@type": "SharedVocabulary",
  "@id": "ssim.ch7.shared_vocabulary",
  "version": "1.0.0",
  "name": "SSIM Chapter 7 - Shared Vocabulary",
  "description": "Common field definitions, types, enums, and patterns used across all SSIM Chapter 7 record types. This vocabulary is referenced by individual record specifications to ensure consistency.",

  "encoding": {
    "@id": "ssim.encoding",
    "name": "SSIM Encoding Standards",
    "description": "Character encoding standards for SSIM files. All SSIM records support both ASCII and EBCDIC with defined control characters.",
    "allowed": [
      "ASCII",
      "EBCDIC"
    ],
    "ascii": {
      "blank_hex": "0x20",
      "blank_char": " ",
      "blank_desc": "Space character for padding",
      "zero_hex": "0x30",
      "zero_char": "0",
      "zero_desc": "Numeric zero character for padding"
    },
    "ebcdic": {
      "blank_hex": "0x40",
      "blank_desc": "EBCDIC space character",
      "zero_hex": "0xF0",
      "zero_desc": "EBCDIC numeric zero"
    }
  },

  "statusLegend": {
    "@id": "ssim.field_status",
    "name": "Field Status Codes",
    "description": "Defines whether a field is mandatory, conditional, or optional in SSIM records.",
    "M": {
      "name": "Mandatory",
      "description": "Field must be present and contain valid data"
    },
    "C": {
      "name": "Conditional",
      "description": "Field is required only under specific conditions"
    },
    "O": {
      "name": "Optional",
      "description": "Field may be present or blank-filled"
    }
  },

  "conventions": {
    "@id": "ssim.conventions",
    "name": "SSIM Field Conventions",
    "description": "Standard conventions for field encoding, alignment, and padding.",
    "positions": {
      "indexing": "zero-based",
      "description": "Byte positions are zero-indexed (0-199 for 200-byte records). This aligns with programming language array indexing.",
      "note": "IATA SSIM documentation uses 1-based indexing (1-200). Implementation uses 0-based for direct byte array access."
    },
    "padding": "Unless noted, blanks (spaces) are used to pad unused bytes.",
    "fill_rules": {
      "blank": {
        "description": "Fill with space characters",
        "ascii": "0x20",
        "ebcdic": "0x40"
      },
      "zero": {
        "description": "Fill with numeric zero characters",
        "ascii": "0x30",
        "ebcdic": "0xF0"
      }
    },
    "alignment": {
      "left": {
        "description": "Left-justify content; pad on the right with fill character",
        "example": "'AB' in 5 bytes → 'AB   ' (3 trailing spaces)"
      },
      "right": {
        "description": "Right-justify content; pad on the left with fill character",
        "example": "'123' in 5 bytes → '  123' (2 leading spaces)"
      }
    }
  },

  "sharedFields": {
    "@id": "ssim.shared_fields",
    "name": "Common Field Definitions",
    "description": "Field definitions that appear across multiple record types with identical structure.",

    "record_type": {
      "@type": "FieldDefinition",
      "@id": "ssim.field.record_type",
      "name": "record_type",
      "fieldType": "string",
      "position": {
        "start": 0,
        "end": 0,
        "length": 1
      },
      "status": "M",
      "description": "Record type discriminator. Single character identifying the record type (1-5).",
      "enum": ["1", "2", "3", "4", "5"],
      "validation": {
        "type": "enum",
        "values": ["1", "2", "3", "4", "5"],
        "errorMessage": "Record type must be '1', '2', '3', '4', or '5'"
      },
      "aiNotes": "Record type identifier - THE FIRST BYTE of every SSIM record.\n\nValues:\n- '1' = Header Record (RT1) - File start marker\n- '2' = Carrier Record (RT2) - Carrier schedule block start\n- '3' = Flight Leg Record (RT3) - Individual flight data\n- '4' = Segment Data Record (RT4) - Additional flight data (DEI-based)\n- '5' = Trailer Record (RT5) - Carrier schedule block end\n\nPurpose:\nEnables record type detection when parsing sequential 200-byte blocks. Parser reads byte 0, switches on value to determine record structure.\n\nValidation:\n- Must be exactly one of: '1', '2', '3', '4', '5'\n- ASCII: 0x31-0x35\n- Any other value is invalid (file corruption)\n\nParsing pattern:\n```typescript\nfunction parseRecord(buffer: Uint8Array): Record {\n  const recordType = String.fromCharCode(buffer[0]);\n  switch (recordType) {\n    case '1': return parseHeaderRecord(buffer);\n    case '2': return parseCarrierRecord(buffer);\n    case '3': return parseFlightRecord(buffer);\n    case '4': return parseSegmentRecord(buffer);\n    case '5': return parseTrailerRecord(buffer);\n    default: throw new Error(`Invalid record type: ${recordType}`);\n  }\n}\n```"
    },

    "record_serial_number": {
      "@type": "FieldDefinition",
      "@id": "ssim.field.record_serial_number",
      "name": "record_serial_number",
      "fieldType": "integer",
      "position": {
        "start": 194,
        "end": 199,
        "length": 6
      },
      "status": "M",
      "width": 6,
      "align": "right",
      "pad": "zero",
      "format": {
        "zero_pad": 6,
        "radix": 10
      },
      "range": {
        "min": 1,
        "max": 999999
      },
      "description": "Sequential record counter. 6-digit zero-padded integer (000001-999999) that increments for each record in the file.",
      "validation": {
        "type": "range",
        "min": 1,
        "max": 999999,
        "errorMessage": "Serial number must be between 000001 and 999999"
      },
      "aiNotes": "Sequential record counter - LAST 6 BYTES of every SSIM record.\n\nFormat:\n- 6-digit zero-padded integer\n- Range: 000001 to 999999\n- Right-justified, zero-padded\n- Examples: '000001', '000123', '999999'\n\nNumbering scheme:\n- RT1 (Header): Always '000001'\n- Subsequent records: Increment by 1\n- RT5 (Trailer): Highest number in carrier block\n\nValidation:\n- Each record must be previous_serial + 1\n- No gaps allowed (detects missing records)\n- No duplicates allowed (detects file corruption)\n\nOverflow handling:\nIf count > 999999:\n- Wrap to 000002 (skip 000001, reserved for RT1)\n- Log warning (files this large are rare)\n- Continue sequential increment\n\nIntegrity checking:\n```typescript\nfunction validateSerialSequence(\n  records: Record[]\n): ValidationResult {\n  for (let i = 1; i < records.length; i++) {\n    const expected = (records[i-1].record_serial_number % 999999) + 1;\n    const actual = records[i].record_serial_number;\n    \n    // Handle overflow: 999999 → 000002\n    const expectedWithOverflow = expected === 1 ? 2 : expected;\n    \n    if (actual !== expectedWithOverflow) {\n      return {\n        valid: false,\n        error: `Serial gap at record ${i}: expected ${expectedWithOverflow}, got ${actual}`\n      };\n    }\n  }\n  return { valid: true };\n}\n```"
    },

    "airline_designator": {
      "@type": "FieldDefinition",
      "@id": "ssim.field.airline_designator",
      "name": "airline_designator",
      "fieldType": "string",
      "position": {
        "start": 2,
        "end": 4,
        "length": 3
      },
      "status": "M",
      "align": "left",
      "pad": "blank",
      "pattern": "^[A-Z0-9]{2}[A-Z0-9 ]$",
      "description": "IATA airline designator. 2-3 alphanumeric characters, left-justified with blank padding.",
      "validation": {
        "type": "pattern",
        "pattern": "^[A-Z0-9]{2}[A-Z0-9 ]$",
        "errorMessage": "Airline designator must be 2-3 alphanumeric characters"
      },
      "aiNotes": "IATA airline code - appears in RT2, RT3, RT4, RT5.\n\nFormat:\n- 2-character codes: Right-padded with blank (e.g., 'QF ' for Qantas)\n- 3-character codes: No padding (e.g., 'QFA')\n- Always left-justified, blank-padded to 3 bytes\n- Total width: 3 bytes (start: 2, end: 4, length: 3)\n\nExamples:\n- 'QF ' = Qantas Airways (2-char + blank)\n- 'AA ' = American Airlines\n- 'BA ' = British Airways  \n- 'VA ' = Virgin Australia\n- 'B6 ' = JetBlue Airways\n- 'UA ' = United Airlines\n- 'WS ' = WestJet\n\nValidation:\n- First 2 chars: Must be alphanumeric [A-Z0-9]\n- Third char: Alphanumeric or blank\n- All uppercase (no lowercase)\n\nCommon error:\nNot blank-padding 2-char codes:\n- Wrong: 'QF' (2 bytes)\n- Correct: 'QF ' (3 bytes with trailing blank)\n\nParsing:\n```typescript\nfunction parseAirlineDesignator(buffer: Uint8Array, start: number): string {\n  // Read 3 bytes starting at 'start'\n  const raw = String.fromCharCode(...buffer.slice(start, start + 3));\n  \n  // Trim trailing blanks for display\n  return raw.trimEnd(); // 'QF ' → 'QF'\n}\n```\n\nLinking:\n- RT2 defines carrier\n- RT3, RT4 must match RT2 airline\n- RT5 should match RT2 airline (closes carrier block)"
    },

    "flight_number": {
      "@type": "FieldDefinition",
      "@id": "ssim.field.flight_number",
      "name": "flight_number",
      "fieldType": "string",
      "position": {
        "start": 5,
        "end": 8,
        "length": 4
      },
      "status": "M",
      "align": "right",
      "pad": "blank",
      "pattern": "^[A-Z0-9 ]{4}$",
      "description": "Flight number. 1-4 alphanumeric characters, right-justified with left blank padding.",
      "validation": {
        "type": "pattern",
        "pattern": "^[A-Z0-9 ]{4}$",
        "errorMessage": "Flight number must be 1-4 alphanumeric characters"
      },
      "aiNotes": "Flight number - appears in RT3, RT4.\n\nFormat:\n- 1-4 alphanumeric characters\n- Right-justified, left-padded with blanks\n- Total width: 4 bytes\n\nExamples:\n- '   1' = Flight 1 (3 leading blanks)\n- '  12' = Flight 12 (2 leading blanks)\n- ' 123' = Flight 123 (1 leading blank)\n- '1234' = Flight 1234 (no padding)\n- ' 12A' = Flight 12A (alphanumeric)\n- '0450' = Flight 450 (zero-padded variant)\n\nNormalization:\n- Strip leading blanks for display: '   1' → '1'\n- Preserve for encoding: Must maintain 4-byte width\n\nComposite key:\nCombined with airline_designator to identify flight:\n- 'QF ' + '   1' = QF1 (Qantas Flight 1)\n- 'AA ' + ' 123' = AA123 (American Flight 123)\n- 'UA ' + '0450' = UA450 (United Flight 450)\n\nParsing:\n```typescript\nfunction parseFlightNumber(buffer: Uint8Array, start: number): string {\n  // Read 4 bytes starting at 'start'\n  const raw = String.fromCharCode(...buffer.slice(start, start + 4));\n  \n  // Trim leading/trailing blanks for display\n  return raw.trim(); // '   1' → '1'\n}\n```"
    }
  },

  "sharedSemanticRules": {
    "@id": "ssim.shared_semantic_rules",
    "name": "Cross-Record Semantic Rules",
    "description": "Validation rules that apply across multiple record types or to file-level structure.",

    "rules": [
      {
        "@type": "SemanticRule",
        "@id": "ssim.ch7#sr.fixed_length_200",
        "id": "sr.fixed_length_200",
        "name": "Fixed Record Length",
        "description": "All SSIM Chapter 7 records must be exactly 200 bytes. This is a fundamental requirement of the fixed-width format.",
        "check": "internal",
        "severity": "error",
        "appliesTo": ["RT1", "RT2", "RT3", "RT4", "RT5"],
        "validation_logic": "For each record:\n1. Read record bytes\n2. Verify length === 200\n3. If length !== 200: CRITICAL ERROR (file corruption)\n4. Reject record and log error",
        "aiNotes": "FUNDAMENTAL RULE: All records are exactly 200 bytes.\n\nWhy 200 bytes?\n- Legacy mainframe format (card punch era)\n- Fixed-width enables fast sequential parsing\n- 5 records = 1000-byte block (block-oriented I/O)\n\nValidation:\n```typescript\nfunction validateRecordLength(buffer: Uint8Array): boolean {\n  if (buffer.length !== 200) {\n    throw new Error(\n      `Invalid record length: ${buffer.length} bytes ` +\n      `(expected 200 bytes)`\n    );\n  }\n  return true;\n}\n```\n\nCommon causes of length errors:\n- File truncation (incomplete write)\n- Encoding issues (UTF-8 vs ASCII)\n- Line ending conversion (CRLF added)\n- Text mode file read (instead of binary)\n\nRecovery:\n- Cannot recover from length errors\n- Reject entire file\n- Request file resend from source"
      },
      {
        "@type": "SemanticRule",
        "@id": "ssim.ch7#sr.record_serial_overflow",
        "id": "sr.record_serial_overflow",
        "name": "Serial Number Overflow Handling",
        "description": "Record Serial Numbers are 6-digit fields (000001-999999). If count exceeds 999999, numbering wraps to 000002 (000001 is reserved for RT1).",
        "check": "external",
        "severity": "warning",
        "appliesTo": ["RT1", "RT2", "RT3", "RT4", "RT5"],
        "validation_logic": "Monitor record_serial_number throughout parse:\n1. RT1 must be 000001\n2. Subsequent records increment sequentially\n3. If serial reaches 999999:\n   - Next record wraps to 000002 (skip 000001)\n   - Log warning about overflow\n4. Detect gaps or duplicates\n5. Verify continuity across overflow boundary",
        "aiNotes": "OVERFLOW RULE: Serial wraps from 999999 → 000002.\n\nNormal sequence:\n- 000001: RT1 (Header)\n- 000002: RT2 (Carrier)\n- ...\n- 999999: Last record before overflow\n\nOverflow sequence (rare, 1M+ records):\n- 999998: Record\n- 999999: Record ← Max value\n- 000002: Record ← Wrapped! Skip 000001 (RT1 only)\n- 000003: Continue...\n\nKey rules:\n1. 000001 is ALWAYS RT1 (never reused)\n2. Overflow wraps to 000002\n3. Sequential increments continue\n4. Log warning when overflow detected\n\nImplementation:\n```typescript\nfunction nextSerialNumber(current: number): number {\n  if (current === 999999) {\n    console.warn('Serial overflow: 999999 → 000002');\n    return 2;\n  }\n  return current + 1;\n}\n```\n\nReality:\n- 999,999 records × 200 bytes = ~200MB\n- Most files < 100,000 records (< 20MB)\n- Overflow is rare but must be handled\n- Large consolidator files might overflow"
      },
      {
        "@type": "SemanticRule",
        "@id": "ssim.ch7#sr.block_padding",
        "id": "sr.block_padding",
        "name": "Block Boundary Padding",
        "description": "SSIM files use 1000-byte blocks. After final record in a block, pad remaining bytes with zeros to reach block boundary.",
        "check": "external",
        "severity": "warning",
        "appliesTo": ["RT5"],
        "validation_logic": "After each record:\n1. Calculate position: current_byte_offset\n2. Check if at block boundary: (position % 1000) === 0\n3. If not at boundary:\n   - Calculate padding: 1000 - (position % 1000)\n   - Verify padding bytes are zeros (0x30/0xF0)\n   - Skip padding, continue to next block\n4. If at boundary: Continue immediately",
        "aiNotes": "BLOCK ALIGNMENT: 1000-byte blocks for legacy compatibility.\n\nBlock structure:\n- 1 block = 1000 bytes\n- 1 record = 200 bytes\n- 1 block = 5 records (5 × 200 = 1000)\n\nPadding rules:\n- After last record in block\n- Pad to next 1000-byte boundary\n- Use zeros (ASCII 0x30 '0', EBCDIC 0xF0)\n- NOT blanks (0x20) or nulls (0x00)\n\nExample:\n- Record ends at byte 600\n- Block boundary at 1000\n- Padding: 400 bytes (600 → 1000)\n- Fill bytes 600-999 with '0' characters\n\nWhy?\n1. Legacy mainframe systems (block I/O)\n2. Tape storage requirements\n3. File integrity verification\n4. Buffering efficiency\n\nValidation:\n```typescript\nfunction validateBlockPadding(\n  position: number,\n  encoding: 'ascii' | 'ebcdic'\n): void {\n  const paddingChar = encoding === 'ascii' ? 0x30 : 0xF0;\n  const positionInBlock = position % 1000;\n  \n  if (positionInBlock !== 0) {\n    const paddingNeeded = 1000 - positionInBlock;\n    const paddingBytes = readBytes(paddingNeeded);\n    \n    if (!paddingBytes.every(b => b === paddingChar)) {\n      console.warn('Block padding contains non-zero bytes');\n    }\n  }\n}\n```"
      },
      {
        "@type": "SemanticRule",
        "@id": "ssim.ch7#sr.file_structure",
        "id": "sr.file_structure",
        "name": "File Structure Hierarchy",
        "description": "SSIM files follow strict structure: RT1 → [RT2 → [RT3 → [RT4]*]* → RT5]* → EOF",
        "check": "external",
        "severity": "error",
        "appliesTo": ["RT1", "RT2", "RT3", "RT4", "RT5"],
        "validation_logic": "Enforce hierarchical structure:\n1. File must start with RT1 (Header)\n2. RT1 followed by one or more RT2 (Carrier) blocks\n3. Each RT2 contains:\n   - Zero or more RT3 (Flight Leg) records\n   - Each RT3 may have zero or more RT4 (Segment) records\n   - Exactly one RT5 (Trailer) to close the carrier block\n4. RT5 continuation_end_code determines if more carriers follow:\n   - 'C' = Continue (expect next RT2)\n   - 'E' = End (expect EOF)\n5. Validate no orphaned records (RT3 without RT2, RT4 without RT3)",
        "aiNotes": "FILE STRUCTURE: Hierarchical record organization.\n\nValid structure:\n```\nRT1 (Header) ← File start, always first\n├─ RT2 (Carrier: QF) ← Opens carrier block\n│  ├─ RT3 (Flight QF1) ← Flight leg\n│  │  ├─ RT4 (DEI 106) ← Segment data\n│  │  └─ RT4 (DEI 122) ← More segment data\n│  ├─ RT3 (Flight QF2)\n│  │  └─ RT4 (DEI 106)\n│  └─ RT5 (Trailer: QF, code='C') ← Closes QF block, more coming\n├─ RT2 (Carrier: VA) ← Opens next carrier block\n│  ├─ RT3 (Flight VA1)\n│  └─ RT5 (Trailer: VA, code='E') ← Closes VA block, end of file\n└─ EOF\n```\n\nCardinalities:\n- RT1: Exactly 1 (file header)\n- RT2: 1 or more (one per carrier)\n- RT3: 0 or more per RT2 (flights)\n- RT4: 0 or more per RT3 (segments)\n- RT5: Exactly 1 per RT2 (trailer matches carrier)\n\nValidation state machine:\n```typescript\ntype State = 'START' | 'AFTER_RT1' | 'IN_CARRIER' | 'IN_FLIGHT' | 'END';\n\nfunction validateFileStructure(records: Record[]): ValidationResult {\n  let state: State = 'START';\n  let currentCarrier: string | null = null;\n  let currentFlight: FlightKey | null = null;\n  \n  for (const record of records) {\n    switch (state) {\n      case 'START':\n        if (record.record_type !== '1') {\n          return { valid: false, error: 'File must start with RT1' };\n        }\n        state = 'AFTER_RT1';\n        break;\n        \n      case 'AFTER_RT1':\n        if (record.record_type !== '2') {\n          return { valid: false, error: 'RT1 must be followed by RT2' };\n        }\n        currentCarrier = record.airline_designator;\n        state = 'IN_CARRIER';\n        break;\n        \n      case 'IN_CARRIER':\n        if (record.record_type === '3') {\n          currentFlight = extractFlightKey(record);\n          state = 'IN_FLIGHT';\n        } else if (record.record_type === '5') {\n          // Close carrier block\n          if (record.continuation_end_code === 'E') {\n            state = 'END';\n          } else {\n            state = 'AFTER_RT1'; // Expect next RT2\n          }\n        } else {\n          return { valid: false, error: 'Invalid record in carrier block' };\n        }\n        break;\n        \n      case 'IN_FLIGHT':\n        if (record.record_type === '4') {\n          // Validate RT4 links to current flight\n          if (!matchesFlightKey(record, currentFlight)) {\n            return { valid: false, error: 'RT4 does not link to RT3' };\n          }\n        } else if (record.record_type === '3') {\n          currentFlight = extractFlightKey(record);\n        } else if (record.record_type === '5') {\n          state = 'IN_CARRIER'; // Process RT5\n          continue;\n        } else {\n          return { valid: false, error: 'Invalid record in flight context' };\n        }\n        break;\n        \n      case 'END':\n        return { valid: false, error: 'Data after end marker (RT5 code=E)' };\n    }\n  }\n  \n  return { valid: state === 'END' };\n}\n```"
      }
    ]
  },

  "sharedExtensions": {
    "@id": "ssim.shared_extensions",
    "name": "Common Extension Patterns",
    "description": "Extension field patterns that can be applied to records for computed or derived data.",

    "patterns": [
      {
        "@type": "ExtensionPattern",
        "@id": "ssim.extension.processing_metadata",
        "name": "processing_metadata",
        "description": "Metadata about parsing/processing operations. Can be attached to any record.",
        "type": "object",
        "properties": {
          "source_file": {
            "type": "string",
            "description": "Original filename"
          },
          "file_checksum": {
            "type": "string",
            "description": "SHA256 or MD5 hash of source file"
          },
          "parsed_at": {
            "type": "string",
            "format": "iso8601",
            "description": "Timestamp when record was parsed"
          },
          "parser_version": {
            "type": "string",
            "description": "Version of parser used"
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "List of validation errors encountered"
          }
        }
      }
    ]
  },

  "deiVersioning": {
    "@id": "ssim.dei_versioning",
    "name": "DEI Versioning Notes",
    "description": "Data Element Identifiers (DEIs) in Chapter 2 are the most frequently updated component of the SSIM specification. New DEI values and codes are added across editions while the Chapter 7 record structure remains stable.",
    "updatedDEIs": [
      {
        "dei": "001",
        "name": "Joint Operation Airline Designators",
        "change": "Expanded for complex codeshare, franchise, and wet-lease arrangements"
      },
      {
        "dei": "010",
        "name": "Aircraft Type/Configuration",
        "change": "New IATA aircraft type codes added regularly (B737 MAX family, A350 variants, A321XLR, A220, etc.)"
      },
      {
        "dei": "109",
        "name": "Meal Service",
        "change": "Updated meal codes for new dietary and premium meal categories"
      },
      {
        "dei": "111",
        "name": "Operational Suffix",
        "change": "Clarified guidance for disambiguation of wet-lease vs franchise vs codeshare operations"
      },
      {
        "dei": "503",
        "name": "Traffic Restriction Code",
        "change": "New restriction codes for EU261/EC261 regulatory compliance and regional passenger rights"
      },
      {
        "dei": "504",
        "name": "Codeshare Information",
        "change": "Expanded for complex multi-partner codeshare, franchise, and virtual interline arrangements"
      },
      {
        "dei": "505",
        "name": "Electronic Ticketing Indicator",
        "change": "Updated for expanded ticketing scenarios including interline e-ticketing"
      }
    ],
    "note": "Parsers should handle unknown DEIs gracefully — return raw segment_data with a warning rather than failing."
  },

  "references": [
    "IATA SSIM, March 2011 — Chapter 7 (Record Formats)",
    "IATA SSIM, March 2011 — Chapter 2 (Data Element Identifiers)",
    "IATA SSIM, Subsequent editions (25th-31st) — Chapter 2 DEI updates",
    "IATA Worldwide Airport Slot Guidelines (WASG) — Season boundary definitions",
    "W3C JSON-LD 1.1 Specification",
    "W3C RDF 1.1 Specification"
  ]
}
